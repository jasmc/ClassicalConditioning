      "origin": "project-default",
      "value": {"pilot_measurements_required": ["marker diameter and edge width per role", "arrowhead dimensions", "physical dash arrays and offsets", "IQR/error-bar cap dimensions", "key symbol size and symbol-text spacing", "multiline leading and heading gaps", "resolved font glyphs and embedding", "effective opacity and visibility at final size"], "conditional_content": ["amino-acid sequences", "chemical structures", "gels/blots", "Extended Data tables"], "scientific_scope": "scoped selections remain authoritative; inherited legacy plot families are not selected scientific definitions", "render_evidence": "required; policy resolution and theme application do not certify a figure"}
